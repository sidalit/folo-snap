#!/bin/bash
set -euo pipefail

# Preserve the profile across refreshes.
export XDG_CONFIG_HOME="$SNAP_USER_COMMON/.config"
export XDG_CACHE_HOME="$SNAP_USER_COMMON/.cache"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"

# browser-support does not allow Chromium's sandbox; AppArmor confines the snap.
exec "$SNAP/opt/folo/Folo" --no-sandbox "$@"
